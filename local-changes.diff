+                saveVideoHistory(sid.toInt(), epId.toInt(), progress.toLong())
+        }
+        if (Settings.AutoRemoveWatchLater())
+            autoRemoveWatchLater(form)
         return response
     }
+
+    /**
+     * Bilibili-Evolved "自动移出稍后再看": once a video is (almost) finished, remove it from
+     * the watch later list. Unknown aids are ignored by the server.
+     */
+    private fun autoRemoveWatchLater(form: Map<String, String>) {
+        val aid = form["aid"]?.toLongOrNull() ?: return
+        val progress = form["progress"]?.toLongOrNull() ?: return
+        val view = VideoInfoHolder.current?.view as? ViewReply ?: return
+        if (!view.hasArc() || view.arc.aid != aid) return
+        val duration = view.arc.duration
+        // progress -1 means the video was played to the end
+        val finished = progress == -1L || (duration > 0 && progress >= duration - 15)
+        if (!finished) return
+        if (!Accounts.isLogin || Accounts.cookieBiliJct.isEmpty()) return
+        synchronized(removedFromWatchLater) {
+            if (!removedFromWatchLater.add(aid)) return
+        }
+        Utils.async {
+            val json = HttpClient.post(
+                "https://api.bilibili.com/x/v2/history/toview/del",
+                headers = mapOf("Cookie" to "SESSDATA=${Accounts.cookieSESSDATA}"),
+                referer = "https://www.bilibili.com/",
+                body = RequestBody.form("aid" to aid, "csrf" to Accounts.cookieBiliJct),
+            )?.json()
+            Logger.debug { "HistoryReport.autoRemoveWatchLater, aid: $aid, response: $json" }
+            if (json?.optInt("code", -1) == 0)
+                Toasts.showShort("已自动移出稍后再看")
+        }
+    }
 }
