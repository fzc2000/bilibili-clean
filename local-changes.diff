+        val garb = Settings.SimplifyCommentGarb()
+        val vip = Settings.SimplifyCommentVip()
+        val labels = Settings.SimplifyCommentLabels()
+        val pendant = Settings.HideAvatarPendant()
+        val rules = replaceRules()
+        if (!location && !medal && !garb && !vip && !labels && !pendant && rules.isEmpty())
+            return
+        purify(location, medal, garb, vip, labels, pendant, rules)
+    }
