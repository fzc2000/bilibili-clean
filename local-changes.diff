+        if (medal) member.run {
+            clearFansMedalName()
+            clearFansGuardIcon()
+            clearFansHonorIcon()
+        }
+        if (garb) member.run {
+            clearGarbCardImage()
+            clearGarbCardImageWithFocus()
+            clearGarbCardJumpUrl()
+            clearGarbCardNumber()
+            clearGarbCardFanColor()
+        }
+        if (vip) member.run {
