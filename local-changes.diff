+    /** "正则=>替换文本" per line, invalid lines are ignored. */
+    private fun replaceRules(): List<Pair<Regex, String>> {
+        val text = Settings.CommentReplaceRules()
+        if (text == cachedRulesText) return cachedRules
+        cachedRulesText = text
+        return text.lineSequence().mapNotNull { line ->
+            val sep = line.indexOf("=>")
+            if (sep <= 0) return@mapNotNull null
+            val pattern = line.substring(0, sep)
+            val replacement = line.substring(sep + 2)
+            runCatching { pattern.toRegex() to replacement }.getOrNull()
+        }.toList().also { cachedRules = it }
+    }
