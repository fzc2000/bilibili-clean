+        if (medal) member.run {
+            clearFansMedalName()
+            clearFansGuardIcon()
+            clearFansHonorIcon()
+        }
+        if (garb) member.run {
+            clearGarbCardImage()
+            clearGarbCardImageWithFocus()
+            clearGarbCardJumpUrl()
+            clearGarbCardNumber()
+            clearGarbCardFanColor()
+        }
+        if (vip) member.run {
+            clearVipLabelText()
+            clearVipLabelPath()
+            clearVipLabelTheme()
+            clearVipNicknameColor()
+        }
+        if (labels) replyControl.run {
+            clearCardLabels()
+            clearLabelText()
+        }
+        if (pendant) member.clearGarbPendantImage()
+        if (rules.isNotEmpty()) {
+            val message = content.message
+            var newMessage = message
+            for ((regex, replacement) in rules)
+                newMessage = newMessage.replace(regex, replacement)
+            if (newMessage != message) {
+                content.message = newMessage
+                // rich text carries its own copy of the message, drop it so the app falls back
+                if (content.hasRichText()) content.clearRichText()
+            }
+        }
