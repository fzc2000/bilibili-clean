+    private fun purifyDynamicItems(
+        items: List<DynamicItem>,
+        remove: (Int) -> Unit,
+        insert: (Int, DynamicItem) -> Unit,
+        playerArgs: PlayerArgs?,
+        localTime: Int,
+    ) {
+        val rmCommentPreview = Settings.DynRmCommentPreview()
+        val unfold = Settings.DynUnfold()
+        val hidePendant = Settings.HideAvatarPendant()
+        if (!rmCommentPreview && !unfold && !hidePendant) return
+        if (unfold) unfoldItems(items, remove, insert, playerArgs, localTime)
+        items.forEach { item ->
+            if (rmCommentPreview) {
+                item.modulesList.withIndex()
+                    .filter { (_, m) -> m.hasModuleComment() || m.hasModuleInteraction() }
+                    .map { it.index }.asReversed().forEach { item.removeModules(it) }
+            }
+            if (hidePendant) item.withForward().forEach { i ->
+                i.modulesList.forEach { m ->
+                    if (m.hasModuleAuthor()) m.moduleAuthor.author.run {
+                        clearPendant()
+                        avatar.removePendantLayers()
+                    }
+                }
+            }
+        }
+    }
+
+    /**
+     * Replace "N 条动态被折叠" placeholders with the real items via DynDetails.
+     * Skipped on the main thread, network is not allowed there.
+     */
+    private fun unfoldItems(
+        items: List<DynamicItem>,
+        remove: (Int) -> Unit,
+        insert: (Int, DynamicItem) -> Unit,
+        playerArgs: PlayerArgs?,
+        localTime: Int,
+    ) {
+        if (Utils.isCurrentlyOnMainThread()) return
+        val foldIndexes = items.withIndex().filter { (_, item) ->
+            item.modulesList.any { it.hasModuleFold() }
+        }.map { it.index }
+        for (idx in foldIndexes.asReversed()) {
+            val item = items[idx]
+            val ids = item.modulesList.first { it.hasModuleFold() }.moduleFold.foldIds
+            if (ids.isBlank()) continue
+            val details = runCatching {
+                DynamicMoss().dynDetails(DynDetailsReq().apply {
+                    dynamicIds = ids
+                    if (playerArgs != null) this.playerArgs = playerArgs
+                    this.localTime = localTime
+                })
+            }.onFailure {
+                Logger.error(it) { "DynListBase.unfold failed, ids: $ids" }
+            }.getOrNull() ?: continue
+            if (details.listCount == 0) continue
+            remove(idx)
+            details.listList.forEachIndexed { i, d ->
+                d.clearHasFold()
+                insert(idx + i, d)
+            }
+        }
+    }
