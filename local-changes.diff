+    private val htmlEntityRegex by lazy { Regex("""&(#\d+|#x[0-9a-fA-F]+|amp|lt|gt|quot|apos|nbsp);""") }
+
+    private fun String.unescapeHtml(): String {
+        if (indexOf('&') == -1) return this
+        return htmlEntityRegex.replace(this) { m ->
+            when (val entity = m.groupValues[1]) {
+                "amp" -> "&"
+                "lt" -> "<"
+                "gt" -> ">"
+                "quot" -> "\""
+                "apos" -> "'"
+                "nbsp" -> " "
+                else -> runCatching {
+                    val code = if (entity.startsWith("#x")) entity.substring(2).toInt(16)
+                    else entity.substring(1).toInt()
+                    String(Character.toChars(code))
+                }.getOrDefault(m.value)
+            }
+        }
+    }
+
+    /**
+     * Merge danmaku with identical content that appear within [intervalSec] seconds
+     * into a single "content ×N" entry. Advanced (7), code (8) and BAS (9) danmaku are left alone.
+     */
+    private fun mergeDanmaku(reply: DmSegMobileReply, intervalSec: Int) {
+        val elems = reply.elemsList
+        if (elems.size < 2) return
+        val window = intervalSec.coerceAtLeast(1) * 1000
+        val order = elems.indices.sortedBy { elems[it].progress }
+        val anchors = HashMap<String, Int>()
+        val counts = HashMap<Int, Int>()
+        val toRemove = ArrayList<Int>()
+        for (i in order) {
+            val elem = elems[i]
+            if (elem.mode >= 7) continue
+            val key = elem.content.trim()
+            if (key.isEmpty()) continue
+            val anchor = anchors[key]
+            if (anchor != null && elem.progress - elems[anchor].progress <= window) {
+                counts[anchor] = (counts[anchor] ?: 1) + 1
+                toRemove.add(i)
+            } else {
+                anchors[key] = i
+            }
+        }
+        if (toRemove.isEmpty()) return
+        counts.forEach { (idx, n) -> elems[idx].content = "${elems[idx].content} ×$n" }
+        toRemove.sortDescending()
+        toRemove.forEach { reply.removeElems(it) }
+    }
 }
